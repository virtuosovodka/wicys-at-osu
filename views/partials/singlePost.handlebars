
{{#if url}}
<div class="blog-post">
    <div class="blog-content">
        <div class="blog-text-col">
            <div class="blog-text">
                <h2>{{title}}</h2>
                <p class="blog-desc">{{desc}}</p>
            </div>
            <button type="button" class="readMore buttons" data-date="{{date}}" >Read More</button>
        </div>
        <div class="blog-pic">
            <img src="{{url}}" alt="{{alt}}">
        </div>
    </div>
</div>
{{else}}
<div class="blog-post">
    <div class="blog-content column">
        <div class="testimony-text">
            <h2>{{title}}</h2>
            <p class="blog-desc">{{desc}}</p>
        </div>
        <button type="button" class="readMore buttons" data-date="{{date}}">Read More</button>
    </div>
</div>
{{/if}}




