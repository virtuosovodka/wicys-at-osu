<article class="blog-post">
    {{#if photoURL}}
    <div class="blog-pic">
        <img src="/images/{{photoURL}}" alt="{{photoAlt}}">
    </div>
    {{/if}}
    
    <div class="blog-content {{#unless photoURL}}no-image{{/unless}}">
        <h3>{{title}}</h3>
        <div class="blog-date">{{date}}</div>
        <p class="blog-desc">{{description}}</p>
        <button type="button" class="readMore" data-title="{{title}}" data-description="{{description}}" data-photo="{{photoURL}}" data-alt="{{photoAlt}}">
            Read More
        </button>
    </div>
</article>